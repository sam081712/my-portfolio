# ---------- server ----------
PORT=4000
NODE_ENV=development
# Where the frontend will run from. * means any origin is fine — good for local
# testing and "open it from any port / file://" use cases.
# When deploying to PRODUCTION, replace this with your real website domain.
# To allow multiple domains, separate them with commas: https://a.com,https://b.com
CORS_ORIGIN=*

# ---------- secrets (keep RANDOM, never commit to git) ----------
# python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=change_me_long_random_string

# ---------- owner login ----------
# The owner email is normally set once from the Owner Panel itself (a one-time lock, via the UI).
# If you want it fixed at deploy time instead, set it here — it will lock in
# as soon as the server starts for the first time, and the UI's "one-time setup" step is skipped.
# Leave it empty to set it from the UI the first time instead.
OWNER_EMAIL=

# The password is stored here as a bcrypt HASH — the plain password is never stored anywhere.
# Generate one with:
#   python scripts/hash_password.py "NewPassword"   -> paste the output here
OWNER_PASSWORD_HASH=change_me_run_hash_password_script

# ---------- shop ----------
# The shop's WhatsApp number, with country code, no leading + (e.g. 91 = India).
# The frontend's "wa.me" links point at this number.
SHOP_PHONE=918318640642
